# Supabase — from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # server-only, never expose to client

# Anthropic — for the agentic planner
ANTHROPIC_API_KEY=

# External data APIs (all optional — wrappers fall back to these defaults)
USGS_OGC_BASE_URL=https://api.waterdata.usgs.gov/ogcapi/v0
USGS_STATS_BASE_URL=https://waterservices.usgs.gov/nwis/stat
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com/v1

# Mapbox (Spot Finder map + Stage 6 nearby-fly-shop POI search)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Brave Search (Stage 6 report links — optional; the feature degrades silently
# to "no links shown" when the key is missing)
BRAVE_SEARCH_API_KEY=

# Optional base-URL overrides for the Stage 6 wrappers
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1
MAPBOX_SEARCH_BASE_URL=https://api.mapbox.com/search/searchbox/v1